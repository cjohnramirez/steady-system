# Copy to .env.local and fill in. Every variable here is read somewhere in src/;
# nothing else is. .env.local is git-ignored; this file must stay empty of secrets.

# Supabase project. Settings then API in the dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row-level security entirely, so it must never be prefixed
# with NEXT_PUBLIC_ and must only be used after an explicit admin role check.
SUPABASE_SERVICE_KEY=

# Absolute origin, used to build the password-reset redirect link.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Cloudinary, for announcement, article, playlist and avatar images.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
